# Copy to .env and adjust. Flags override these values.

# Listen address (loopback by default)
ADDR=127.0.0.1:8080

# Max stored requests per inbox
MAX=500

# Reverse-proxy captured requests to a local app (optional).
# For the demo services: forward to the order service origin.
# FORWARD=http://127.0.0.1:3001

# Default replay target URL (optional).
# For the demo: replay payment.succeeded at the order webhook.
# REPLAY_URL=http://127.0.0.1:3001/webhooks/payment
